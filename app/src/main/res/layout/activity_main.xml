<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F7FB">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="bKash Payment Bridge"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Connect this phone to your website. Real bKash Merchant notifications will be matched with customer Transaction IDs and order amounts."
            android:textSize="14sp"
            android:textColor="#667085"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="1. Connect to Website"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#111827"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/connectionStatus"
                android:text="Website connection: NOT CONNECTED"
                android:textColor="#475467"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/serverUrl"
                android:hint="Website API URL, e.g. https://example.com/api"
                android:inputType="textUri"
                android:singleLine="true"
                android:layout_marginTop="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/pairingCode"
                android:hint="Pairing Code, e.g. ABCD-2345"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/deviceName"
                android:hint="Phone name"
                android:singleLine="true"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/pairButton"
                android:text="Connect Phone"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/testButton"
                android:text="Test Website Connection"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/disconnectButton"
                android:text="Disconnect Local App"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="2. Notification Access"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#111827"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/notificationStatus"
                android:text="Notification access: OFF"
                android:textColor="#475467"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/openNotificationSettings"
                android:text="Open Notification Access Settings"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="3. Sync Status"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#111827"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/queueStatus"
                android:text="Pending sync: 0"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/syncStatus"
                android:text="No sync has run yet."
                android:textColor="#667085"
                android:textSize="13sp"
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/syncButton"
                android:text="Sync Pending Payments Now"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Last Detected bKash Payment"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#111827"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/lastPayment"
                android:text="No bKash Merchant payment notification detected yet."
                android:textColor="#475467"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="9dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
